{
  "defaultState": "idle",
  "blendMode": "normal",
  "clips": {
    "idle": { "fps": 24, "loop": true },
    "hover": { "fps": 12, "loop": true },
    "poke": { "fps": 15, "loop": false },
    "starEasy": { "fps": 12, "loop": false },
    "starHard": { "fps": 12, "loop": false },
    "enter": { "fps": 12, "loop": false },
    "combo50": { "fps": 12, "loop": false },
    "combo200": { "fps": 12, "loop": false },
    "combo300": { "fps": 12, "loop": false },
    "miss": { "fps": 12, "loop": false },
    "idlePlay": { "fps": 10, "loop": false },
    "idleYawn": { "fps": 8, "loop": false },
    "idleSleep": { "fps": 6, "loop": true }
  },
  "states": {
    "idle": { "clip": "idle" },
    "hover": { "clip": "hover" },
    "poke": { "clip": "poke", "next": "idle" },
    "starEasy": { "clip": "starEasy", "next": "idle" },
    "starHard": { "clip": "starHard", "next": "idle" },
    "enter": { "clip": "enter", "next": "idle" },
    "combo50": { "clip": "combo50", "next": "idle" },
    "combo200": { "clip": "combo200", "next": "idle" },
    "combo300": { "clip": "combo300", "next": "idle" },
    "miss": { "clip": "miss", "next": "idle" },
    "idlePlay": { "clip": "idlePlay", "next": "idle" },
    "idleYawn": { "clip": "idleYawn", "next": "idle" },
    "idleSleep": { "clip": "idleSleep" }
  },
  "starBands": [
    { "min": 0, "max": 2, "goto": "starEasy" },
    { "min": 4.5, "max": 99, "goto": "starHard" }
  ],
  "rules": [
    { "when": "hover", "action": "play", "goto": "hover", "interrupt": true },
    { "when": "hoverEnd", "action": "play", "goto": "idle" },
    { "when": "click", "action": "play", "goto": "poke", "interrupt": true },

    { "when": "gameplayEnter", "action": "hide" },

    { "when": "combo", "at": 200, "action": "show", "goto": "combo200", "interrupt": true },
    { "when": "combo", "at": 500, "action": "hide" },

    { "when": "miss", "action": "play", "goto": "miss", "interrupt": true },
    { "when": "idle", "afterSeconds": 300, "action": "play", "goto": "idlePlay" },
    { "when": "idle", "afterSeconds": 600, "action": "play", "goto": "idleYawn" },
    { "when": "idle", "afterSeconds": 900, "action": "play", "goto": "idleSleep" }
  ]
}
