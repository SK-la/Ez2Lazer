<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>Ez2Lazer</Title>
    <PackageId>ez2lazer.Game</PackageId>
    <AssemblyName>osu.Game</AssemblyName>
    <Version>0.0.0</Version>
    <PackageIcon>icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
    <!-- Ez2Lazer 的 framework/resources 依赖恒为预发布版本，打包时无需提示。 -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup Label="Icon">
    <None Include="..\assets\lazer-nuget.png">
      <Pack>True</Pack>
      <PackagePath>icon.png</PackagePath>
    </None>
  </ItemGroup>
  <PropertyGroup Label="Fody">
    <EzFodyVersion>6.9.3</EzFodyVersion>
    <!-- 已有 .nupkg.metadata 时 NuGet 不再解压。缺 build\Fody.targets 时生成的导入带 Exists 条件，条件失败则编织被整段跳过，删 obj 也只会记下这个缺口。 -->
    <EzFodyPackageDir>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))fody\$(EzFodyVersion)</EzFodyPackageDir>
    <EzFodyNupkgPath>$(EzFodyPackageDir)\fody.$(EzFodyVersion).nupkg</EzFodyNupkgPath>
    <EzFodyTargetsPath>$(EzFodyPackageDir)\build\Fody.targets</EzFodyTargetsPath>
    <EzNugetGeneratedTargets>$(MSBuildProjectExtensionsPath)$(MSBuildProjectFile).nuget.g.targets</EzNugetGeneratedTargets>
    <EzNugetGeneratedTargetsText Condition="Exists('$(EzNugetGeneratedTargets)')">$([System.IO.File]::ReadAllText('$(EzNugetGeneratedTargets)'))</EzNugetGeneratedTargetsText>
    <EzFodyImportedByNuget Condition="$(EzNugetGeneratedTargetsText.Contains('Fody.targets'))">true</EzFodyImportedByNuget>
  </PropertyGroup>
  <ItemGroup Label="Package References">
    <!-- Held back due to licencing change stupidness. Silenced vulnerability does not affect us. -->
    <PackageReference Include="AutoMapper" Version="13.0.1">
      <NoWarn>NU1903</NoWarn>
    </PackageReference>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" Version="10.0.13" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Toolkit.HighPerformance" Version="7.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ppy.LocalisationAnalyser" Version="2026.611.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 直接引用。Fody 的编织目标在 build/，只作为 Realm 的传递依赖时不会导入。 -->
    <PackageReference Include="Fody" Version="$(EzFodyVersion)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Realm" Version="20.1.0"/>
    <PackageReference Include="ez2lazer.Framework" Version="[$(Ez2LazerFrameworkVersion)]" Condition="'$(UseEz2LazerLocalFrameworkProject)' != 'true'"/>
    <PackageReference Include="ez2lazer.Game.Resources" Version="[$(Ez2LazerGameResourcesVersion)]" Condition="'$(UseEz2LazerLocalResourcesProject)' != 'true'"/>
    <PackageReference Include="Sentry" Version="6.12.1" />
    <PackageReference Include="SharpCompress" Version="0.50.8"/>
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0"/>
    <PackageReference Include="TagLibSharp" Version="2.3.0"/>
    <PackageReference Include="Live2DCSharpSDK" Version="1.0.0.6"/>
    <!-- In-process WebAssembly host for the vendored n-key MinaCalc (4-18K mania MSD/SunnySR). -->
    <PackageReference Include="Wasmtime" Version="50.0.1" />

    <!-- Required since Veldrid references a library that depends on Microsoft.DotNet.PlatformAbstractions (2.0.3), which doesn't play nice with Realm. -->
    <PackageReference Include="System.IO.FileSystem.Primitives" Version="4.3.0">
      <NoWarn>NU1510</NoWarn>
    </PackageReference>
    <PackageReference Include="System.Runtime.InteropServices" Version="4.3.0">
      <NoWarn>NU1510</NoWarn>
    </PackageReference>
    <PackageReference Include="System.Runtime.Handles" Version="4.3.0">
      <NoWarn>NU1510</NoWarn>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseEz2LazerLocalFrameworkProject)' == 'true'">
    <ProjectReference Include="$(Ez2LazerFrameworkProjectPath)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseEz2LazerLocalResourcesProject)' == 'true'">
    <ProjectReference Include="$(Ez2LazerResourcesProjectPath)" />
  </ItemGroup>
  <ItemGroup Label="EzSkills">
    <!-- Deterministic manifest name for the vendored n-key MinaCalc wasm (4-18K MSD/SunnySR). -->
    <EmbeddedResource Update="Resources\EzSkills\minaclac-74.0.wasm" LogicalName="osu.Game.Resources.EzSkills.minaclac-74.0.wasm" />
    <!-- Licence/provenance notes are not runtime payload. -->
    <EmbeddedResource Remove="Resources\EzSkills\NOTICE.md" />
  </ItemGroup>
  <Import Project="$(EzFodyTargetsPath)"
          Condition="'$(DisableFody)' != 'true' and Exists('$(EzFodyTargetsPath)') and '$(EzFodyImportedByNuget)' != 'true'" />
  <!-- Restore 时 ExcludeRestorePackageImports 会跳过 nuget.g.props，NuGetPackageRoot 为空。路径必须在目标内重算。 -->
  <Target Name="RepairEzFodyTargetsExtract">
    <PropertyGroup>
      <_EzFodyRoot Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</_EzFodyRoot>
      <_EzFodyRoot Condition="'$(_EzFodyRoot)' == '' and '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</_EzFodyRoot>
      <_EzFodyRoot Condition="'$(_EzFodyRoot)' == ''">$(UserProfile)\.nuget\packages\</_EzFodyRoot>
      <_EzFodyDir>$([MSBuild]::EnsureTrailingSlash('$(_EzFodyRoot)'))fody\$(EzFodyVersion)</_EzFodyDir>
      <_EzFodyNupkg>$(_EzFodyDir)\fody.$(EzFodyVersion).nupkg</_EzFodyNupkg>
      <_EzFodyTargets>$(_EzFodyDir)\build\Fody.targets</_EzFodyTargets>
    </PropertyGroup>
    <Message Importance="high" Condition="!Exists('$(_EzFodyTargets)') and Exists('$(_EzFodyNupkg)')" Text="Fody 包缓存缺少 build\Fody.targets，正在从 nupkg 补回。" />
    <Exec Condition="!Exists('$(_EzFodyTargets)') and Exists('$(_EzFodyNupkg)')" Command="tar -xf &quot;$(_EzFodyNupkg)&quot; -C &quot;$(_EzFodyDir)&quot; build/Fody.targets" />
  </Target>
  <Target Name="RepairEzFodyTargetsExtractBeforeRestore" BeforeTargets="Restore">
    <CallTarget Targets="RepairEzFodyTargetsExtract" />
  </Target>
  <Target Name="RepairEzFodyTargetsExtractAfterRestore" AfterTargets="Restore">
    <CallTarget Targets="RepairEzFodyTargetsExtract" />
  </Target>
  <!-- $(FodyAssembly) 只在 Fody.targets 被导入时存在。包缓存缺文件时 NuGet 的导入不会执行。 -->
  <Target Name="ValidateEzFodyImport"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="RepairEzFodyTargetsExtract"
          Condition="'$(DisableFody)' != 'true' and '$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildProjectDirectory)\FodyWeavers.xml')">
    <Error Condition="'$(FodyAssembly)' == ''"
           Text="Fody.targets 未被导入，$(AssemblyName) 不会被编织，Realm 会在运行期报错。请删除 $(EzFodyPackageDir) 后重新构建。" />
  </Target>
  <Target Name="ValidateEz2LazerSiblingProjects" BeforeTargets="BeforeBuild">
    <Error Condition="'$(UseEz2LazerLocalFrameworkProject)' == 'true' and !Exists('$(Ez2LazerFrameworkProjectPath)')" Text="Missing sibling directory ez2lazer-framework. Please clone https://github.com/SK-la/ez2lazer-framework into $(MSBuildThisFileDirectory)..\..\ez2lazer-framework, or disable UseEz2LazerLocalFrameworkProject to rely on NuGet." />
    <Error Condition="'$(UseEz2LazerLocalResourcesProject)' == 'true' and !Exists('$(Ez2LazerResourcesProjectPath)')" Text="Missing sibling directory ez2lazer-resources. Please clone https://github.com/SK-la/ez2lazer-resources into $(MSBuildThisFileDirectory)..\..\ez2lazer-resources, or disable UseEz2LazerLocalResourcesProject to rely on NuGet." />
  </Target>
</Project>
